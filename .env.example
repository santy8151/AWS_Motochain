# ──────────────────────────────────────────────────────────────
#  ElectroVault — Variables de entorno
#  NUNCA subas este archivo a GitHub. Está en .gitignore
# ──────────────────────────────────────────────────────────────

# Tu clave privada de wallet (sin el prefijo 0x)
# ADVERTENCIA: Usa una wallet de desarrollo, NUNCA tu wallet principal
PRIVATE_KEY=tu_clave_privada_aqui

# RPC URLs (obtén gratis en https://alchemy.com o https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/TU_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/TU_API_KEY

# API Key de Etherscan para verificación de contratos (https://etherscan.io/apis)
ETHERSCAN_API_KEY=tu_etherscan_api_key

# Dirección del contrato desplegado (se llena automáticamente con el deploy script)
VITE_CONTRACT_ADDRESS=
VITE_NETWORK=sepolia
